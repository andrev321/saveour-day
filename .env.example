# Opcjonalnie — pierwsza pozycja harmonogramu
VITE_TIMELINE_CEREMONY_TIME=13:37
VITE_TIMELINE_CEREMONY_LABEL=Ceremonia — Przykładowa świątynia Lorem Ipsum

# Trasa /slub — kawa i ciasto po ceremonii
VITE_SLUB_RECEPTION_DESC=Przykładowy opis: herbata, kawa, ciasto — bez prawdziwych szczegółów.
