{
  "name": "invitation-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:brand": "tsx scripts/build-brand.ts",
    "dev": "npm run dev --workspace @invitations/site",
    "dev:admin": "npm run dev --workspace @invitations/admin",
    "build": "npm run typecheck && npm run build --workspace @invitations/site",
    "build:admin": "npm run build --workspace @invitations/admin",
    "build:demo": "tsx scripts/build-demo.ts",
    "docs:screenshots": "tsx scripts/capture-docs-screenshots.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:production-env": "tsx scripts/check-production-env.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,js}\" \"tests/**/*.{ts,tsx}\" \"*.{js,ts,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check --cache \"apps/**/*.{ts,tsx,js,json,css}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,js}\" \"tests/**/*.{ts,tsx}\" \"*.{js,ts,json,md}\" \".github/**/*.yml\"",
    "typecheck": "tsx scripts/run-parallel.ts typecheck:root typecheck:domain typecheck:admin typecheck:site",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "typecheck:domain": "tsc --noEmit -p packages/domain/tsconfig.json",
    "typecheck:admin": "tsc --noEmit -p apps/admin/tsconfig.json",
    "typecheck:site": "tsc --noEmit -p apps/site/tsconfig.json",
    "lint": "eslint apps packages scripts tests playwright.config.ts playwright.staging.config.ts",
    "lint:cached": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ apps packages scripts tests playwright.config.ts playwright.staging.config.ts",
    "lint:boundaries": "depcruise --cache node_modules/.cache/dependency-cruiser --cache-strategy content packages apps scripts tests",
    "check": "tsx scripts/run-parallel.ts format:check typecheck lint:cached lint:boundaries test",
    "check:deno": "deno check supabase/functions/purge-sites/index.ts",
    "check:static:ci": "npm audit --omit=dev --audit-level=high && tsx scripts/run-parallel.ts format:check typecheck check:deno lint lint:boundaries test",
    "check:ci": "npm run check:static:ci && npm run test:e2e:ci",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ci": "tsx scripts/e2e-ci.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@mantine/core": "9.8.2",
    "@mantine/form": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@mantine/notifications": "9.8.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "qr-code-styling": "1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "styled-components": "^6.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
