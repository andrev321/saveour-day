{
  "name": "invitation-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:brand": "tsx scripts/build-brand.ts",
    "dev": "npm run dev --workspace @invitations/site",
    "dev:admin": "npm run dev --workspace @invitations/admin",
    "build": "npm run typecheck && npm run build --workspace @invitations/site",
    "build:admin": "npm run build --workspace @invitations/admin",
    "build:demo": "tsx scripts/build-demo.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:production-env": "tsx scripts/check-production-env.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,css}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,js}\" \"tests/**/*.{ts,tsx}\" \"*.{js,ts,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json,css}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,js}\" \"tests/**/*.{ts,tsx}\" \"*.{js,ts,json,md}\" \".github/**/*.yml\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/domain/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json",
    "lint": "eslint apps packages scripts tests playwright.config.ts playwright.staging.config.ts",
    "lint:boundaries": "depcruise packages apps scripts tests",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run lint:boundaries && npm test",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@mantine/core": "9.8.0",
    "@mantine/form": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "qr-code-styling": "1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "styled-components": "^6.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
