{
  "name": "invitation-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:brand": "tsx scripts/build-brand.ts",
    "dev": "npm run dev --workspace @invitations/site",
    "dev:admin": "npm run dev --workspace @invitations/admin",
    "build": "npm run typecheck && npm run build --workspace @invitations/site",
    "build:admin": "npm run build --workspace @invitations/admin",
    "build:demo": "tsx scripts/build-demo.ts",
    "check:production-env": "tsx scripts/check-production-env.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/admin/tsconfig.json && tsc --noEmit -p apps/site/tsconfig.json",
    "lint": "eslint apps packages scripts tests",
    "lint:boundaries": "depcruise packages apps tests",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries && npm test",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "import:legacy": "tsx scripts/import-legacy.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@mantine/core": "9.6.1",
    "@mantine/form": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "qr-code-styling": "1.9.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "0.35.4",
    "styled-components": "^6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.2",
    "@types/pg": "8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "pg": "8.16.3",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
